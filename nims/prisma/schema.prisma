generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             Int        @id @default(autoincrement())
  name           String
  username       String     @unique
  email          String?    @unique
  passwordHash   String
  roleId         Int
  role           Role       @relation(fields: [roleId], references: [id])
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?
  auditLogs      AuditLog[]
  createdDevices Device[]   @relation("CreatedDevices")
  updatedDevices Device[]   @relation("UpdatedDevices")
  createdConnections NetworkConnection[] @relation("CreatedConnections")
  updatedConnections NetworkConnection[] @relation("UpdatedConnections")
  uploadedDocuments Document[] @relation("UploadedDocuments")
  topologyLayouts   TopologyLayout[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Site {
  id          Int      @id @default(autoincrement())
  siteCode    String   @unique
  name        String
  siteType    String   @default("pop") // pop, dc, office, customer_site, other
  address     String?
  city        String?
  province    String?
  latitude    Float?
  longitude   Float?
  status      String   @default("active") // active, inactive, maintenance
  description String?
  parentSiteId Int?
  parentSite   Site?    @relation("SiteHierarchy", fields: [parentSiteId], references: [id], onDelete: SetNull)
  childSites   Site[]   @relation("SiteHierarchy")
  rooms       Room[]
  racks       Rack[]
  devices     Device[]
  subnets     Subnet[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentSiteId])
  @@index([siteType])
}

model Room {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name        String
  floor       String?
  description String?
  racks       Rack[]
  devices     Device[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, name])
}

model Rack {
  id           Int      @id @default(autoincrement())
  siteId       Int
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  roomId       Int?
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  name         String
  unitCapacity Int      @default(42)
  description  String?
  devices      Device[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([siteId, name])
}

model Vendor {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  website        String?
  supportContact String?
  notes          String?
  models         DeviceModel[]
  devices        Device[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model DeviceCategory {
  id          Int           @id @default(autoincrement())
  name        String
  code        String        @unique // router, switch, olt, ont, server, radio, firewall, other
  description String?
  models      DeviceModel[]
  devices     Device[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DeviceModel {
  id             Int            @id @default(autoincrement())
  vendorId       Int
  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryId     Int
  category       DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modelName      String
  modelCode      String         @unique
  description    String?
  specifications Json?
  devices        Device[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Device {
  id              Int            @id @default(autoincrement())
  deviceCode      String         @unique
  hostname        String
  categoryId      Int
  category        DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId        Int
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  modelId         Int?
  model           DeviceModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  serialNumber    String?
  siteId          Int
  site            Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  roomId          Int?
  room            Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rackId          Int?
  rack            Rack?          @relation(fields: [rackId], references: [id], onDelete: SetNull)
  networkRole     String?        // core, distribution, access, aggregation, cpe, server, other
  inventoryStatus String         @default("PLANNED") // PLANNED, ACTIVE, MAINTENANCE, RETIRED, LOST
  managementNotes String?
  description     String?
  installedAt     DateTime?
  warrantyExpiry  DateTime?
  ownerTeam       String?
  createdBy       Int?
  creator         User?          @relation("CreatedDevices", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy       Int?
  updater         User?          @relation("UpdatedDevices", fields: [updatedBy], references: [id], onDelete: SetNull)
  archivedAt      DateTime?
  archiveReason   String?
  interfaces      Interface[]
  ipAddresses     IpAddress[]
  documents       Document[]
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([hostname])
  @@index([serialNumber])
  @@index([siteId])
  @@index([categoryId])
  @@index([inventoryStatus])
  @@index([archivedAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // CREATE, UPDATE, DELETE, ARCHIVE, RESTORE, LOGIN, EXPORT
  entityType String   // Site, Room, Rack, Vendor, DeviceCategory, DeviceModel, Device, User, etc.
  entityId   Int?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Interface {
  id            Int         @id @default(autoincrement())
  deviceId      Int
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name          String
  label         String?
  interfaceType String      @default("ethernet") // ethernet, sfp, sfp_plus, qsfp, pon, wireless, loopback, vlan, lag, management, other
  mediaType     String?     // copper, fiber_single_mode, fiber_multi_mode, wireless
  speedMbps     Int?        // 10, 100, 1000, 10000, 25000, 40000, 100000
  adminStatus   String      @default("enabled") // enabled, disabled
  operStatus    String      @default("unknown") // up, down, testing, unknown
  macAddress    String?
  portMode      String?     // access, trunk, routed
  vlanId        Int?
  description   String?
  ipAddresses   IpAddress[]
  connectionsAsA NetworkConnection[] @relation("EndpointA")
  connectionsAsB NetworkConnection[] @relation("EndpointB")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([deviceId, name])
  @@index([deviceId])
  @@index([name])
}

model Subnet {
  id          Int         @id @default(autoincrement())
  name        String
  cidr        String      @unique
  ipVersion   String      @default("IPv4") // IPv4, IPv6
  siteId      Int?
  site        Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  gatewayIp   String?
  vlanId      Int?
  purpose     String      @default("management") // management, loopback, point_to_point, access, server, public, other
  status      String      @default("active") // active, reserved, deprecated
  description String?
  ipAddresses IpAddress[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([cidr])
  @@index([siteId])
}

model IpAddress {
  id               Int        @id @default(autoincrement())
  address          String
  ipVersion        String     @default("IPv4") // IPv4, IPv6
  subnetId         Int
  subnet           Subnet     @relation(fields: [subnetId], references: [id], onDelete: Restrict)
  deviceId         Int?
  device           Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  interfaceId      Int?
  interface        Interface? @relation(fields: [interfaceId], references: [id], onDelete: SetNull)
  purpose          String     @default("management") // management, loopback, point_to_point, nat, carp, other
  allocationStatus String     @default("ALLOCATED") // AVAILABLE, ALLOCATED, RESERVED, RELEASED
  hostname         String?
  assignedAt       DateTime?
  releasedAt       DateTime?
  description      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([subnetId, address])
  @@index([address])
  @@index([deviceId])
  @@index([interfaceId])
  @@index([subnetId])
  @@index([allocationStatus])
  @@index([purpose])
}

model NetworkConnection {
  id                   Int       @id @default(autoincrement())
  endpointAInterfaceId Int
  endpointAInterface   Interface @relation("EndpointA", fields: [endpointAInterfaceId], references: [id], onDelete: Cascade)
  endpointBInterfaceId Int
  endpointBInterface   Interface @relation("EndpointB", fields: [endpointBInterfaceId], references: [id], onDelete: Cascade)
  relationType         String    @default("physical") // physical, logical, parent_child, service
  medium               String?   // fiber, copper, wireless, logical, unknown
  label                String?
  status               String    @default("documented") // documented, under_review, archived
  capacityMbps         Int?
  description          String?
  createdBy            Int?
  creator              User?     @relation("CreatedConnections", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy            Int?
  updater              User?     @relation("UpdatedConnections", fields: [updatedBy], references: [id], onDelete: SetNull)
  archivedAt           DateTime?
  archiveReason        String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([endpointAInterfaceId, endpointBInterfaceId])
  @@index([endpointAInterfaceId])
  @@index([endpointBInterfaceId])
  @@index([relationType])
  @@index([status])
  @@index([archivedAt])
}

model Document {
  id               Int       @id @default(autoincrement())
  deviceId         Int?
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  storageKey       String    @unique
  originalFilename String
  mimeType         String
  fileSize         Int
  checksum         String    // SHA-256
  category         String    @default("other") // photo, topology_diagram, config_backup, warranty, manual, contract, other
  sensitivityLevel String    @default("internal") // public, internal, confidential, restricted
  description      String?
  uploadedBy       Int?
  uploader         User?     @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: SetNull)
  uploadedAt       DateTime  @default(now())
  archivedAt       DateTime?
  archiveReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([deviceId])
  @@index([category])
  @@index([checksum])
  @@index([archivedAt])
}

model TopologyLayout {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String   @default("default") // e.g. "default", "site-1", "all"
  positions Json     // Record<deviceId, { x: number, y: number }>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope])
  @@index([userId])
}
